{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun run build:*)",
      "Bash(bun run dev:*)",
      "Bash(bun run db:migrate:local:*)",
      "Bash(bun run db:seed:local:*)",
      "Bash(bun run format:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run test:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run cf-typegen:*)",
      "Bash(bun test:*)",
      "Bash(bunx playwright test:*)",
      "Bash(bunx wrangler types:*)",
      "Bash(bunx wrangler d1 execute DB --local:*)",
      "Bash(bunx wrangler d1 migrations apply DB --local:*)",
      "Bash(bunx wrangler d1 migrations list DB --local:*)"
    ],
    "deny": [
      "Bash(bun run deploy:*)",
      "Bash(bun run db:migrate:remote:*)",
      "Bash(bunx wrangler deploy:*)",
      "Bash(bunx wrangler secret:*)",
      "Bash(bunx wrangler d1 execute DB --remote:*)"
    ]
  }
}
