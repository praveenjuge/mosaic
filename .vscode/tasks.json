{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint before commit",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "if grep -q '\"lint\"' package.json; then echo 'Running lint...'; bun run lint; else echo 'No lint script found, skipping...'; fi"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
