{
  "name": "mosaic",
  "description": "Automatically generate Open Graph images for websites with Cloudflare Browser Rendering.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenjuge/mosaic.git"
  },
  "homepage": "https://mosaic.praveenjuge.com",
  "bugs": {
    "url": "https://github.com/praveenjuge/mosaic/issues"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "bun run db:migrate:remote && wrangler deploy",
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' vite dev",
    "dev:frontend": "NODE_OPTIONS='--max-http-header-size=32768' vite dev",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "predev": "tsc --noEmit",
    "preview": "vite preview",
    "start": "vite preview",
    "cf-typegen": "wrangler types"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database storing websites and generated-image metadata."
      },
      "OG_BUCKET": {
        "description": "R2 bucket storing generated Open Graph images."
      },
      "BROWSER": {
        "description": "Browser Run binding used to capture OG screenshots."
      },
      "VITE_SITE_URL": {
        "description": "Required build-time public HTTPS origin for this Mosaic deployment."
      },
      "VITE_CLERK_PUBLISHABLE_KEY": {
        "description": "Required build-time publishable key for the Clerk application."
      },
      "CLERK_SECRET_KEY": {
        "description": "Required runtime secret key for the Clerk application."
      }
    }
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.3.2",
    "@clerk/themes": "^2.4.57",
    "@fontsource-variable/geist": "^5.2.9",
    "@shikijs/rehype": "^4.1.0",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.8.3",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "wrangler": "^4.95.0"
  }
}
