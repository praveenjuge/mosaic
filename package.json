{
  "name": "mosaic",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "content:sync": "bun --eval 'import { createBuilder } from \"@content-collections/core\"; const builder = await createBuilder(\"./content-collections.ts\"); await builder.build();'",
    "dev": "bun --parallel dev:frontend dev:backend",
    "dev:backend": "convex dev",
    "dev:frontend": "vite dev",
    "lint": "eslint --fix",
    "predev": "bun run content:sync && tsc --noEmit",
    "preview": "vite preview",
    "start": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.0.12",
    "@clerk/themes": "^2.4.52",
    "@content-collections/core": "0.14.3",
    "@convex-dev/polar": "0.9.0",
    "@convex-dev/r2": "0.9.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@polar-sh/sdk": "0.47.0",
    "@shikijs/markdown-it": "^3.22.0",
    "@tanstack/react-router": "1.168.13",
    "@tanstack/react-router-devtools": "1.166.11",
    "@tanstack/react-start": "1.167.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@content-collections/vite": "0.2.9",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.0.8",
    "wrangler": "^4.81.1"
  }
}