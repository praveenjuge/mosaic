{
  "name": "mosaic",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:seed-local": "bunx wrangler d1 execute mosaic-prod --local --file schema.sql",
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' vite dev",
    "dev:frontend": "NODE_OPTIONS='--max-http-header-size=32768' vite dev",
    "lint": "eslint --fix",
    "predev": "tsc --noEmit",
    "preview": "vite preview",
    "start": "vite preview",
    "cf-typegen": "wrangler types"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.1.7",
    "@clerk/themes": "^2.4.57",
    "@fontsource-variable/geist": "^5.2.8",
    "@shikijs/rehype": "^4.0.2",
    "@tanstack/react-router": "1.168.24",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-start": "1.167.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "wrangler": "^4.84.1"
  }
