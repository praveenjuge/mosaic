{
  "name": "mosaic",
  "description": "Automatically generate Open Graph images for websites with Cloudflare Browser Rendering.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenjuge/mosaic.git"
  },
  "homepage": "https://mosaic.praveenjuge.com",
  "bugs": {
    "url": "https://github.com/praveenjuge/mosaic/issues"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsgo --noEmit --tsBuildInfoFile node_modules/.cache/tsgo/tsconfig.tsbuildinfo",
    "typecheck:tsc": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-db.jsonc",
    "deploy": "bun run db:migrate:remote && wrangler deploy",
    "deploy:preview": "bun run db:migrate:preview && wrangler preview",
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' vite dev",
    "lint": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:check": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "preview": "vite preview",
    "test": "VITE_SITE_URL=https://mosaic.example VITE_CLERK_PUBLISHABLE_KEY=pk_test bun test",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "bash scripts/visual-test.sh",
    "test:visual:update": "bash scripts/visual-test.sh --update-snapshots",
    "check": "bun scripts/run-parallel.ts check:fast build && bun scripts/run-parallel.ts test:integration test:e2e && bun run test:visual",
    "check:fast": "bun scripts/run-parallel.ts lint:check format:check typecheck cf-typegen:check test",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database storing websites and generated-image metadata."
      },
      "OG_BUCKET": {
        "description": "R2 bucket storing generated Open Graph images."
      },
      "BROWSER": {
        "description": "Browser Run binding used to capture OG screenshots."
      },
      "OG_ANALYTICS": {
        "description": "Workers Analytics Engine dataset recording /use generation outcomes."
      },
      "ANALYTICS_SQL": {
        "description": "Analytics SQL binding the dashboard reads OG_ANALYTICS back with."
      },
      "OG_ANALYTICS_DATASET": {
        "description": "Name of the OG_ANALYTICS dataset, for ANALYTICS_SQL queries."
      },
      "VITE_SITE_URL": {
        "description": "Required build-time public HTTPS origin for this Mosaic deployment."
      },
      "VITE_CLERK_PUBLISHABLE_KEY": {
        "description": "Required build-time publishable key for the Clerk application."
      },
      "CLERK_SECRET_KEY": {
        "description": "Required runtime secret key for the Clerk application."
      }
    }
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@clerk/shared": "^4.40.0",
    "@clerk/tanstack-react-start": "^1.7.3",
    "@clerk/ui": "^1.40.2",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vadivam-react": "^0.0.69",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.47",
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.154.0",
    "yaml": "^2.9.1"
  }
}
