{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosaic",
  "main": "src/server.ts",
  "compatibility_date": "2026-04-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "upload_source_maps": true,
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mosaic-prod",
      "database_id": "ac32231f-9bd4-406d-9d60-d37ae0a5c007",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OG_BUCKET",
      "bucket_name": "mosaic-og-prod",
    },
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "analytics_engine_datasets": [
    {
      "binding": "OG_ANALYTICS",
      "dataset": "mosaic_og_generations",
    },
  ],
  // Reads OG_ANALYTICS back for the dashboard (src/server/stats.ts). The
  // binding is scoped to this Worker's account, so it needs no API token. It
  // only exists remotely; dev reads its own events instead (local-analytics).
  "analytics": {
    "binding": "ANALYTICS_SQL",
    "remote": true,
  },
  "vars": {
    "OG_ANALYTICS_DATASET": "mosaic_og_generations",
  },
  "ratelimits": [
    {
      "name": "DEMO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "SITE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["CLERK_SECRET_KEY"],
  },
  // `wrangler preview` deploys each branch to its own URL. Storage bindings
  // point at preview-only resources so previews never touch production data.
  // Apply migrations with `bun run db:migrate:preview`, which uses
  // `wrangler.preview-db.jsonc` because `wrangler d1` only reads top-level
  // `d1_databases`.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "mosaic-preview",
        "database_id": "ab6df3e5-d807-4b9f-8d35-1b1374423f8a",
        "migrations_dir": "migrations",
      },
    ],
    "r2_buckets": [
      {
        "binding": "OG_BUCKET",
        "bucket_name": "mosaic-og-preview",
      },
    ],
    "browser": {
      "binding": "BROWSER",
    },
    "analytics_engine_datasets": [
      {
        "binding": "OG_ANALYTICS",
        "dataset": "mosaic_og_generations_preview",
      },
    ],
    "analytics": {
      "binding": "ANALYTICS_SQL",
    },
    "vars": {
      "OG_ANALYTICS_DATASET": "mosaic_og_generations_preview",
    },
    "ratelimits": [
      {
        "name": "DEMO_RATE_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "SITE_RATE_LIMITER",
        "namespace_id": "2002",
        "simple": { "limit": 30, "period": 60 },
      },
    ],
  },
}
