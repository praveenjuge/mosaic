{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosaic",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-04-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "placement": {
    "mode": "smart",
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "OG_BUCKET",
      "bucket_name": "mosaic-og-prod",
      "remote": true
    }
  ],
  "vars": {
    "VITE_CONVEX_URL": "https://clear-warthog-996.convex.cloud",
    "VITE_CONVEX_SITE_URL": "https://clear-warthog-996.convex.site",
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubW9zYWljaW1nLmNvbSQ"
  }
}