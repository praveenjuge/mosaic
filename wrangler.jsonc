{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosaic",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-04-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "placement": {
    "mode": "smart",
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false
}