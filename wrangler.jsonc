{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosaic",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-04-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "placement": {
    "mode": "smart",
    "hint": "apac",
  },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  // Single host serves the app + OG images (`/i/<key>`). The legacy domain
  // stays bound to the Worker so it can 301-redirect (and keep `/use` alive).
  "routes": [
    { "pattern": "mosaic.praveenjuge.com", "custom_domain": true },
    { "pattern": "mosaicimg.com", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mosaic-prod",
      "database_id": "ac32231f-9bd4-406d-9d60-d37ae0a5c007",
      // Read replication: enable via Cloudflare Dashboard > D1 > Settings
      // or REST API: PUT /d1/database/{id} with {"read_replication": {"mode": "auto"}}
    },
  ],
  "r2_buckets": [
    {
      "binding": "OG_BUCKET",
      "bucket_name": "mosaic-og-prod",
      "remote": true,
    },
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "vars": {
    // Clerk production publishable key. The payload base64-decodes to the
    // Frontend API host: `clerk.mosaic.praveenjuge.com$`.
    // Requires the Clerk production instance's primary domain to be
    // mosaic.praveenjuge.com with Clerk infrastructure kept on that subdomain
    // (FAPI clerk.mosaic.praveenjuge.com), matching the other *.praveenjuge.com
    // apps. Previous key (clerk.mosaicimg.com$): pk_live_Y2xlcmsubW9zYWljaW1nLmNvbSQ
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubW9zYWljLnByYXZlZW5qdWdlLmNvbSQ",
  },
}
